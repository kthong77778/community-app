# 백엔드 API 주소 설정
#
# 이 파일을 복사해서 사용하세요:
#   개발용:  cp .env.example .env.local      (Git에 커밋되지 않음)
#   배포용:  EAS Secret 또는 빌드 환경 변수로 주입 권장
#
# EXPO_PUBLIC_ 접두사가 붙은 변수만 앱 번들에 포함됩니다.

# 실제 기기에서 개발 서버에 접속할 때는 PC의 LAN IP를 사용하세요.
# (폰에서 localhost는 폰 자신을 가리킵니다.)
# 예) EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
#
# 값을 비워두면 개발 모드에서 자동 추정합니다(src/api/config.ts):
#   - Expo 개발 서버 호스트에서 PC IP 추출
#   - Android 에뮬레이터 → 10.0.2.2
#   - 그 외 → localhost
EXPO_PUBLIC_API_URL=

# 배포(프로덕션) 빌드에서는 반드시 공개 HTTPS 주소로 설정하세요.
# 예) EXPO_PUBLIC_API_URL=https://api.your-domain.com
